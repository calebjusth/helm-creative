              <img 
                src={project.image} 
                alt={`${project.service} Project`} 
                class="h-[60vh] md:h-[75vh] w-auto object-cover grayscale-[20%] group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-out" 
                loading="lazy" 
