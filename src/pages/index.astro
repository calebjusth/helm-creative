---

<Layout title="Home">
  
  <style>
    .reveal-word {
      display: inline-block;
      opacity: 0.9; /* Muted state */
      color: #838383; /* Dim grey */
      transition: color 0.3s ease;
      will-change: opacity, color;
    }
    img, .marquee-col img, .logo-track img, .relative img {
      pointer-events: none;
      user-select: none;
      -webkit-user-drag: none;
    }
    .image-protection { pointer-events: none; position: relative; }
    .reveal-word {
      opacity: 0.2;
      transition: opacity 0.2s ease;
    }
    /* Ensure the font is applied */
    .font-pangram-bold { font-family: 'Pangram', sans-serif; font-weight: 700; }
    /* Pragman / Pangram alias for strategy captions */
    .font-pragman { font-family: 'Pangram', sans-serif; }

    /* Caption bubbles for issue section */
    .caption-bubble { box-shadow: 0 6px 20px rgba(2,6,23,0.6); transition: transform 0.6s cubic-bezier(.2,.9,.2,1), opacity 0.6s; }
    .caption-left .caption-bubble { transform: translateX(0); }
    .caption-right .caption-bubble { transform: translateX(0); }
    .issue-image { will-change: transform, opacity; margin-bottom: -72px; position: relative; z-index: 30; }
    .issue-image-wrap { padding-bottom: 72px; }
    #chat-btn { position: relative; z-index: 20; }

    /* Our Work track */
    .work-marquee-wrapper { cursor: grab; }
    .work-track { will-change: transform; }
    .work-item img { display: block; }
  </style>

  <section class="relative min-h-screen w-full flex flex-col md:flex-row bg-[#0B0E14] overflow-hidden items-center px-6 md:px-16 lg:px-24">
    <div class="z-20 w-full md:w-1/2 space-y-8 pt-40 md:pt-48 pb-20 flex flex-col justify-center">
