        <span class="hero-word">Dream.</span>
        <span class="hero-word italic text-[#f5bd02] font-normal">Create.</span>
        <br class="md:hidden"/>
        <span class="hero-word tracking-tighter">Lead.</span>
      </h1>
      <p class="font-pangram text-white/80 text-sm md:text-base max-w-md leading-relaxed opacity-0 translate-y-4 hero-reveal">
       We are Helm. A creative agency crafting futuristic communication, branding, and digital products. Moving Ethiopian design forward, one dream at a time.
      </p>
      <div class="opacity-0 translate-y-4 hero-reveal">
        <a href="https://t.me/alpha_valley" target="_blank" class="group relative inline-block bg-[#f5bd02] text-black px-8 md:px-10 py-4 md:py-5 rounded-full font-pangram-bold text-[12px] md:text-sm uppercase tracking-widest overflow-hidden transition-all hover:pr-14">
          <span class="relative z-10">Let's Talk</span>
          <span class="absolute right-6 top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 transition-all duration-300">→</span>
        </a>
      </div>
    </div>

    <div class="absolute right-0 top-0 w-full md:w-[45%] h-full flex gap-3 md:gap-6 px-4 py-0 opacity-20 md:opacity-100 pointer-events-none">
      {allCols.map((col) => (
        <div class={`marquee-col flex-1 flex flex-col gap-4 lg:gap-6 ${col.offset}`} data-speed={col.speed}>
