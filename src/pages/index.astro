---

<Layout title="Home">
  <HeroSection allCols={allCols} />
  <TrustedBySection logosRow1={logosRow1} logosRow2={logosRow2} />
  <ManifestoSection />
  <OurWorkSection workProjects={workProjects} />
  <OurService />
  <RevealSection />
  <IssueSection />
  <CreativeSupportSection />
  <FAQSection />

<script>
  // 1. Imports
  import { initMarquee } from '../scripts/marquee.js';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // --- 2. HERO ANIMATIONS (Restored Parallax Scroll) ---
  const initHero = () => {
    // Reveal the text and buttons
    gsap.to('.hero-reveal', {
      opacity: 1,
      y: 0,
      stagger: 0.15,
      duration: 1.2,
      ease: "expo.out"
    });

    // RESTORED: Vertical Parallax Scroll for the Hero Image Columns
    const columns = document.querySelectorAll('.marquee-col');
    columns.forEach((col) => {
      const speed = parseFloat(col.dataset.speed) || 1;
      gsap.to(col, {
        y: -150 * speed, // Moves columns at different rates based on data-speed
        ease: "none",
        scrollTrigger: {
          trigger: "section", // The hero section
          start: "top top",
          end: "bottom top",
          scrub: true
        }
      });
    });
  };

  // --- 3. LOGO MARQUEE ---
  const initLogos = () => {
    const wrappers = document.querySelectorAll('.logo-marquee-wrapper');
    wrappers.forEach((wrapper) => {
      const track = wrapper.querySelector('.logo-track');
      if (!track) return;
      const direction = wrapper.dataset.direction === 'right' ? 1 : -1;

      const original = track.innerHTML;
      if (!track.dataset.duplicated) {
        track.innerHTML = original + original;
        track.dataset.duplicated = 'true';
      }

      let trackWidth = track.scrollWidth / 2;
      let xPos = 0;

      ScrollTrigger.addEventListener('refreshInit', () => {
        trackWidth = track.scrollWidth / 2;
      });

      gsap.set(track, { x: 0 });

      gsap.to({}, {
        duration: 100000,
        onUpdate: () => {
          const scrollDir = ScrollTrigger.direction || 1;
          const speed = 0.5;
          xPos += speed * direction * scrollDir;
          if (direction * scrollDir === -1) {
            if (xPos <= -trackWidth) xPos = 0;
          } else {
            if (xPos >= 0) xPos = -trackWidth;
          }
          gsap.set(track, { x: xPos });
        }
      });
    });
  };

  // --- 4. WORK MARQUEE ---
  const initWorkMarquee = () => {
    const wrapper = document.querySelector('.work-marquee-wrapper');
    if (!wrapper) return;
    const track = wrapper.querySelector('.work-track');
    if (!track) return;

    if (!track.dataset.duplicated) {
      track.innerHTML = track.innerHTML + track.innerHTML;
      track.dataset.duplicated = 'true';
    }

    let trackWidth = track.scrollWidth / 2;
    let xPos = 0;

    ScrollTrigger.addEventListener('refreshInit', () => {
      trackWidth = track.scrollWidth / 2;
    });

    gsap.set(track, { x: 0 });

    const tween = gsap.to({}, {
      duration: 100000,
      onUpdate: () => {
        const speed = 0.6;
        xPos -= speed;
        if (xPos <= -trackWidth) xPos = 0;
        gsap.set(track, { x: xPos });
      }
    });

    wrapper.addEventListener('mouseenter', () => gsap.to(tween, { timeScale: 0.05, duration: 0.4 }));
    wrapper.addEventListener('mouseleave', () => gsap.to(tween, { timeScale: 1, duration: 0.4 }));
  };

  // story bridge removed; static design takes over

  // --- 6. MANIFESTO TEXT REVEAL ---
  const initTextReveal = () => {
    const textElement = document.getElementById('manifesto-text');
    if (!textElement || textElement.dataset.splitDone) return;

    const splitTextIntoWords = (element) => {
      const nodes = Array.from(element.childNodes);
      const fragment = document.createDocumentFragment();
      nodes.forEach(node => {
        if (node.nodeType === 3) {
          const words = node.textContent.split(/(\s+)/);
          words.forEach(word => {
            if (word.trim().length > 0) {
              const span = document.createElement('span');
              span.className = 'reveal-word';
              span.textContent = word;
              fragment.appendChild(span);
            } else {
              fragment.appendChild(document.createTextNode(word));
            }
          });
        } else {
          const clonedNode = node.cloneNode(true);
          fragment.appendChild(clonedNode);
        }
      });
      element.innerHTML = '';
      element.appendChild(fragment);
      element.dataset.splitDone = 'true';
    };

    splitTextIntoWords(textElement);
    const words = textElement.querySelectorAll('.reveal-word');

    gsap.set(words, { color: "#525252", filter: "blur(8px)", opacity: 0.2 });

    gsap.to(words, {
      color: "#ffffff",
      filter: "blur(0px)",
      opacity: 1,
      stagger: 0.1,
      scrollTrigger: {
        trigger: textElement,
        start: "top 80%",
        end: "bottom 50%",
        scrub: 1,
      }
    });
  };

  // --- 7. SECTION REVEAL - FIXED VERSION ---
  const initSectionReveal = () => {
    const container = document.querySelector('#reveal-container');
    const box = document.querySelector('#reveal-box');
    const content = document.querySelector('#reveal-content');
    const image = document.querySelector('#reveal-image');
    const revealItems = document.querySelectorAll('.reveal-item');
    
    if (!container || !box || !content) return;

    // Reset initial state
    gsap.set(box, {
      scale: 0.8,
      y: 100,
      width: "80%",
      height: "80%",
      borderRadius: "1.5rem"
    });
    
    gsap.set(content, { opacity: 0 });
    gsap.set(revealItems, { opacity: 0, y: 20 });
    gsap.set(image, { opacity: 0, y: 50 });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: container,
        start: "top 80%",
        end: "top 20%",
        scrub: 0.8,
        markers: false // Set to true for debugging
      }
    });

    // Animate the box expanding
    tl.to(box, {
      y: 0,
      scale: 1,
      width: "100%",
      height: "100%",
      borderRadius: "0px",
      duration: 1
    })
    // Fade in content container
    .to(content, {
      opacity: 1,
      duration: 0.5
    }, "-=0.5")
    // Animate text items
    .to(revealItems, {
      y: 0,
      opacity: 1,
      stagger: 0.15,
      duration: 0.7
    }, "-=0.4")
    // Animate image
    .to(image, {
      opacity: 1,
      y: 0,
      duration: 0.8
    }, "-=0.6");
  };

  // --- 8. ISSUE SECTION ---
  const initIssueSection = () => {
    const sec = document.querySelector('#issue-section');
    if (!sec) return;
    const img = sec.querySelector('.issue-image');
    const left = sec.querySelector('.reveal-left');
    const right = sec.querySelector('.reveal-right');

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: sec,
        start: 'top 85%',
        end: 'top 35%',
        scrub: 0.7,
      }
    });
    tl.to(img, { opacity: 1, y: 0, scale: 1, duration: 0.9 })
      .to([left, right], { opacity: 1, x: 0, stagger: 0.1 }, "-=0.6");
  };

  // --- 9. MASTER INITIALIZATION ---
  const initAll = () => {
    initHero();
    initLogos();
    initTextReveal();
    initSectionReveal(); // This will now work correctly
    initIssueSection();
    initWorkMarquee();

    // Call external marquee if function exists
    if (typeof initMarquee === 'function') {
      initMarquee();
    }
  };

  initAll();

  document.addEventListener('astro:after-swap', () => {
    ScrollTrigger.getAll().forEach(t => t.kill());
    initAll();
  });
</script>

</Layout>
