            {col.images.concat(col.images).map((img) => (
              <div class="w-full rounded-xl md:rounded-2xl overflow-hidden bg-white/5 aspect-[4/5] shadow-2xl image-protection">
                <img src={img} class="w-full h-full object-cover grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all duration-700" loading="lazy" />
