  <style>
    /* Seamless Marquee Animation */
    .work-track {
      animation: scroll 40s linear infinite;
    }

    .work-track:hover {
      animation-play-state: paused;
    }

    @keyframes scroll {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    /* Outline text helper */
    .stroke-black {
      -webkit-text-stroke: 1px #0B0E14;
    }
  </style>

  <script>
    import { initMarquee } from '../scripts/marquee.js';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // --- 1. HERO ANIMATIONS ---
    const initHero = () => {
        gsap.to('.hero-reveal', { 
            opacity: 1, 
            y: 0, 
            stagger: 0.15, 
            duration: 1.2, 
            ease: "expo.out" 
        });
    };

    // --- 3.5 MANIFESTO TONE (mute -> white) ---
    const initManifestoTone = () => {
      const el = document.getElementById('manifesto-text');
      if (!el) return;

      const words = el.querySelectorAll('.reveal-word');
      if (words && words.length) {
        gsap.set(words, { color: 'rgba(255,255,255,0.65)' });
        gsap.to(words, {
          color: 'rgba(255,255,255,1)',
          stagger: { each: 0.02, from: 'start' },
          ease: 'none',
          scrollTrigger: {
            trigger: el,
            start: 'top 90%',
            end: 'top 30%',
            scrub: 0.6,
            invalidateOnRefresh: true
          }
        });
      } else {
        // fallback to whole element
        gsap.to(el, {
          color: 'rgba(255,255,255,1)',
          ease: 'none',
          scrollTrigger: {
            trigger: el,
            start: 'top 90%',
            end: 'top 30%',
            scrub: 0.6,
            invalidateOnRefresh: true
          }
        });
      }
    };

    // --- 2. MARQUEE LOGIC ---
    const initLogos = () => {
        const wrappers = document.querySelectorAll('.logo-marquee-wrapper');
        wrappers.forEach((wrapper) => {
            const track = wrapper.querySelector('.logo-track');
            if(!track) return;
        const direction = wrapper.dataset.direction === 'right' ? 1 : -1;

        // Duplicate track content for seamless looping
        const original = track.innerHTML;
        if (!track.dataset.duplicated) {
          track.innerHTML = original + original;
          track.dataset.duplicated = 'true';
        }

        let trackWidth = track.scrollWidth / 2;
        let xPos = 0;

        // Recalculate on resize/refresh
        ScrollTrigger.addEventListener('refreshInit', () => {
          trackWidth = track.scrollWidth / 2;
        });

        gsap.set(track, { x: 0 });

        gsap.to({}, {
          duration: 100000,
          onUpdate: () => {
            const scrollDir = ScrollTrigger.direction || 1;
            const speed = 0.5;
            xPos += speed * direction * scrollDir;
            if (direction * scrollDir === -1) {
               if (xPos <= -trackWidth) xPos = 0;
            } else {
               if (xPos >= 0) xPos = -trackWidth;
            }
            gsap.set(track, { x: xPos });
          }
        });
        });
    };

    // --- OUR WORK HORIZONTAL MARQUEE ---
    const initWorkMarquee = () => {
      const wrapper = document.querySelector('.work-marquee-wrapper');
      if (!wrapper) return;
      const track = wrapper.querySelector('.work-track');
      if (!track) return;

      // Duplicate only once
      if (!track.dataset.duplicated) {
        track.innerHTML = track.innerHTML + track.innerHTML;
        track.dataset.duplicated = 'true';
      }

      let trackWidth = track.scrollWidth / 2;
      let xPos = 0;

      ScrollTrigger.addEventListener('refreshInit', () => {
        trackWidth = track.scrollWidth / 2;
      });

      gsap.set(track, { x: 0 });

      const tween = gsap.to({}, {
        duration: 100000,
        onUpdate: () => {
          const speed = 0.6;
          xPos -= speed;
          if (xPos <= -trackWidth) xPos = 0;
          gsap.set(track, { x: xPos });
        }
      });

      // pause on hover
      wrapper.addEventListener('mouseenter', () => gsap.to(tween, { timeScale: 0.05, duration: 0.4 }));
      wrapper.addEventListener('mouseleave', () => gsap.to(tween, { timeScale: 1, duration: 0.4 }));
    };

    // --- 3. TEXT REVEAL ---
    const initTextReveal = () => {
      const textElement = document.getElementById('manifesto-text');
      if (!textElement) return;

      // 1. Function to wrap words without destroying HTML structure (like <br> and <span>)
      const splitTextIntoWords = (element) => {
        const nodes = element.childNodes;
        const fragment = document.createDocumentFragment();

        nodes.forEach(node => {
          if (node.nodeType === 3) { // Text node
            const words = node.textContent.split(/(\s+)/);
            words.forEach(word => {
              if (word.trim().length > 0) {
                const span = document.createElement('span');
                span.className = 'reveal-word';
                span.textContent = word;
                fragment.appendChild(span);
              } else {
                fragment.appendChild(document.createTextNode(word)); // Keep whitespace
              }
            });
          } else if (node.nodeType === 1) { // Element node (like <span> or <br>)
            if (node.tagName === 'BR') {
              fragment.appendChild(node.cloneNode());
            } else {
              // Recurse into nested spans (to preserve the yellow color)
              const clonedSpan = node.cloneNode(false);
              splitTextIntoWords(node); // Split the original's children
              while (node.firstChild) clonedSpan.appendChild(node.firstChild);
              fragment.appendChild(clonedSpan);
            }
          }
        });
        
        element.innerHTML = '';
        element.appendChild(fragment);
      };

      // Run the split
      splitTextIntoWords(textElement);

      // 2. GSAP Animation
      const words = textElement.querySelectorAll('.reveal-word');
      
      gsap.to(words, {
        opacity: 1,
        color: "#f5f5f5", // Fade to pure white
        stagger: 0.1,    // Delay between words
        ease: "none",
        scrollTrigger: {
          trigger: textElement,
          start: "top 85%",    // Animation starts when top of text hits 85% of screen
          end: "bottom 60%",   // Animation finishes when bottom hits 60%
          scrub: true,         // Ties animation directly to scroll speed
        }
      });
    };

    // --- 4. SECTION REVEAL (THE UPDATE) ---
    const initSectionReveal = () => {
      const container = document.querySelector('#reveal-container');
      const box = document.querySelector('#reveal-box');
      const content = document.querySelector('#reveal-content');
      const items = document.querySelectorAll('.reveal-item');
      const image = document.querySelector('#reveal-image');

      if (!container || !box) return;

      // Reset states immediately before building timeline
      // Improved initial states to avoid layout jumps and make scrub smoother
      gsap.set(box, { y: 60, scale: 0.98, borderRadius: "24px", width: "80%", height: "80%" });
      gsap.set(content, { opacity: 0 });
      gsap.set(items, { y: 30, opacity: 0 });
      gsap.set(image, { y: "40%" });

      // Use a scrubbed timeline without pinning to avoid jump/glitch issues.
      // Start when the container top hits 80% of viewport and finish by 10%.
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: container,
          start: "top 80%",
          end: "top 10%",
          scrub: 0.8,
          invalidateOnRefresh: true
        }
      });

      tl.to(box, {
        y: 0,
        scale: 1,
        width: "100%",
        height: "100%",
        borderRadius: "0px",
        ease: "power1.out"
      })
      .to(content, {
        opacity: 1,
        duration: 0.6
      }, "-=0.6")
      .to(items, {
        y: 0,
        opacity: 1,
        stagger: 0.12,
        duration: 0.6,
        ease: "power2.out"
      }, "-=0.4")
      .to(image, {
        y: "10%",
        duration: 0.8,
        ease: "power2.out"
      }, "-=0.6");
    };

    // --- 4.5 ISSUE / STRATEGY SECTION ---
    const initIssueSection = () => {
      const sec = document.querySelector('#issue-section');
      if (!sec) return;

      const img = sec.querySelector('.issue-image');
      const left = sec.querySelector('.caption-left .caption-bubble');
      const right = sec.querySelector('.caption-right .caption-bubble');

      gsap.set(img, { opacity: 0, y: -30, scale: 0.98, transformOrigin: '50% 100%' });
      gsap.set([left, right], { opacity: 0, x: 40 });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: sec,
          start: 'top 85%',
          end: 'top 35%',
          scrub: 0.7,
          invalidateOnRefresh: true
        }
      });

      // Image drops/settles onto the button with a soft elastic feel on enter,
      // and reverses on leave. No parallax scrub to avoid dark overlay/glitch.
      tl.to(img, { opacity: 1, y: 6, scale: 1, duration: 0.9, ease: 'elastic.out(1, 0.65)' })
        .to(left, { opacity: 1, x: 0, duration: 0.6, ease: 'power2.out' }, '-=0.6')
        .to(right, { opacity: 1, x: 0, duration: 0.6, ease: 'power2.out' }, '-=0.65');
    };

    // --- INIT ---
    const initAll = () => {
        initHero();
        initLogos();
        initMarquee();
        initTextReveal();
      initManifestoTone();
      initSectionReveal();
      initIssueSection();
      initWorkMarquee();
    };

    initAll();

    document.addEventListener('astro:after-swap', () => {
        ScrollTrigger.getAll().forEach(t => t.kill());
        initAll();
    });

    // Ripple logic
    const btn = document.getElementById('cinematic-btn');
    if(btn) {
        btn.addEventListener('mouseenter', () => {
             const ripple = document.getElementById('btn-ripple');
             if(ripple) { ripple.style.transform = "scale(15)"; ripple.style.opacity = "1"; }
        });
        btn.addEventListener('mouseleave', () => {
             const ripple = document.getElementById('btn-ripple');
             if(ripple) { ripple.style.transform = "scale(0)"; ripple.style.opacity = "0"; }
        });
    }
  </script>
</Layout>