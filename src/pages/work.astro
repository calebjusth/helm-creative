// Page SEO Meta
const title = "Portfolio | Selected Digital Works & Web Development";
const description = "Explore our portfolio of selected works featuring high-end web development, SEO strategies, and complete brand transformations including Abetu Medical Center.";
---

<Layout title={title} description={description}>
  <section class="relative bg-brand-navy px-5 md:px-8 lg:px-10 pt-32 pb-14" aria-labelledby="hero-title">
    <div class="max-w-7xl mx-auto">
      <p class="font-sans text-[10px] md:text-xs tracking-[0.26em] uppercase text-brand-white/70 mb-3">Selected Projects</p>
      <h1 id="hero-title" class="font-display font-bold text-5xl md:text-8xl leading-[0.9] tracking-[-0.06em] text-brand-white max-w-4xl">Selected Works</h1>
    </div>
  </section>

  <OurWorkSection workProjects={workProjects} />
  <CreativeSupportSection />
  <FAQSection />

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Selected Works Portfolio",
    "description": "A showcase of web development, branding, and SEO projects including Abetu Medical Center.",
    "hasPart": workProjects.map(p => ({
      "@type": "CreativeWork",
      "name": p.service,
      "description": p.description,
      "datePublished": p.year,
      "url": p.url,
      "image": p.image
    }))
  })}>
  </script>

</Layout>