---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404: Page Not Found">
  <section class="min-h-screen w-full flex items-center justify-center bg-[#0B0E14] text-[#f5f5f5] px-6">
    <div class="max-w-2xl mx-auto text-center relative">

      
      <!-- Content overlay -->
      <div class="absolute inset-0 flex flex-col items-center justify-center">
        <div class="space-y-6">
          <!-- Badge -->
          <span class="inline-block px-4 py-2 border border-[#f5bd02]/20 rounded-full text-xs  tracking-[0.25em] text-[#f5bd02] font-pangram">
           404 Error
          </span>
          
          <!-- Main message -->
          <h2 class="font-monument text-3xl md:text-5xl  tracking-tight">
            You've
            <span class="block text-[#f5bd02] italic mt-2">Drifted</span>
          </h2>
          
          <!-- Description -->
          <p class="font-pangram text-[#f5f5f5]/60 max-w-md mx-auto text-base leading-relaxed">
            The page you're looking for can't be found.<br><br> 
            Let's get you back to familiar waters.
          </p>
          
          <!-- Action -->
          <div class="pt-6">
            <a 
              href="/" 
              class="group inline-flex items-center gap-3 border border-[#f5bd02] hover:bg-[#f5bd02] hover:text-white text-[#f5bd02] hover:text-[#0B0E14] transition-all duration-500 px-8 py-4 rounded-full font-pangram-bold text-xs  tracking-[0.2em]"
            >
              Return Home
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>