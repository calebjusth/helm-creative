---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404: Page Not Found">
  <section class="min-h-screen w-full flex items-center justify-center bg-[#FAF9F6] text-[#1a1a1a] px-6">
    <div class="max-w-2xl mx-auto text-center">
      <h1 class="font-display font-bold text-5xl md:text-7xl leading-none tracking-[-0.04em] text-[#1a1a1a]">
        Page not found
      </h1>
      <a href="/" class="mt-8 inline-flex items-center gap-3 font-sans text-lg text-[#1a1a1a] underline underline-offset-8">
        Go to home
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>