---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "Helm Creative Agency - Leading Digital Studio for Design & Strategy", 
  image = "/og-image.webp" 
} = Astro.props;

const socialImage = new URL(image, 'https://helm-creative.vercel.app/');

import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- fav icons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="helm" />
    
    <!-- Optional: Theme color for mobile browsers -->
    <meta name="theme-color" content="#FAF9F6" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title} | Creative Agency™</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImage} />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  </head>
  <body class="bg-brand-navy text-brand-white antialiased selection:bg-brand-gold selection:text-black overflow-x-hidden">

    <header id="site-header" class="fixed top-0 left-0 w-full z-[70] p-6 md:px-12 md:py-8 flex justify-between items-center transition-all duration-500 ease-in-out">
      <a href="/" class="group flex items-center z-[80]">
        <img 
          src="/logo-icon/main-black.png" 
          alt="Helm Logo" 
          class="h-16 w-auto object-contain block sm:hidden" 
        />
        <img 
          src="/logo-icon/main-black.png" 
          alt="Helm Logo" 
          class="h-60 md:h-10 w-auto object-contain hidden sm:block" 
        />
      </a>

      <div class="flex items-center gap-3 md:gap-6">
        <a href="tel:+251959516667" target="_blank" class="hidden sm:flex items-center gap-2 text-brand-white hover:text-brand-gold transition-colors">
          <i class="fas fa-phone-alt text-sm md:text-base"></i>
          <span class="text-xs md:text-sm font-sans font-medium">Call Us</span>
        </a>

        <a href="tel:+251959516667" target="_blank" class="flex sm:hidden items-center justify-center w-10 h-10 rounded-full bg-white/5 text-brand-white hover:text-brand-gold hover:bg-white/10 transition-colors">
          <i class="fas fa-phone-alt text-sm"></i>
          <span class="sr-only">Call Us</span>
        </a>
        
        <a href="https://wa.me/251959516667" target="_blank" class="group hidden sm:flex items-center gap-2 bg-[#1a1a1a] text-[#FAF9F6] hover:bg-[#2a2a2a] px-4 md:px-6 py-2 md:py-3 rounded-full transition-all duration-300">
          <i class="fab fa-whatsapp text-sm md:text-base"></i>
          <span class="text-xs md:text-sm font-sans">WhatsApp Us</span>
        </a>

        <a href="https://wa.me/251959516667" target="_blank" class="group flex sm:hidden items-center justify-center w-10 h-10 rounded-full bg-[#1a1a1a] text-[#FAF9F6] hover:bg-[#2a2a2a] transition-all duration-300">
          <i class="fab fa-whatsapp text-sm"></i>
          <span class="sr-only">WhatsApp Us</span>
        </a>

        <button id="menu-toggle" class="group flex items-center gap-4 z-[80] outline-none border-none bg-transparent">
          <span class="text-[10px] font-sans font-bold tracking-widest hidden md:block group-hover:text-brand-gold transition-colors">
            Menu
          </span>
          <div class="flex flex-col gap-1.5 items-end">
            <span id="line-1" class="block w-8 h-[1px] bg-brand-white group-hover:bg-brand-gold transition-all duration-300"></span>
            <span id="line-2" class="block w-5 h-[1px] bg-brand-white group-hover:bg-brand-gold transition-all duration-300"></span>
          </div>
        </button>
      </div>
    </header>

    <div id="menu-overlay" class="fixed inset-0 bg-brand-navy z-[60] transform translate-x-full transition-transform duration-700 cubic-bezier flex flex-col items-center justify-center pointer-events-none opacity-0">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-gold/5 to-transparent opacity-30 pointer-events-none"></div>
      
      <nav class="relative z-50 flex flex-col items-center space-y-6 text-center">
        
        <a href="/" 
           class="menu-link font-display uppercase text-3xl md:text-5xl font-bold hover:text-brand-gold transition-all duration-300 opacity-0 translate-y-10"
           style="transition-delay: 0.1s">
          Home
        </a>

        <a href="/our_service" 
           class="menu-link font-display uppercase text-3xl md:text-5xl font-bold hover:text-brand-gold transition-all duration-300 opacity-0 translate-y-10"
           style="transition-delay: 0.15s">
          Our Services
        </a>

        <a href="/work" 
           class="menu-link font-display uppercase text-3xl md:text-5xl font-bold hover:text-brand-gold transition-all duration-300 opacity-0 translate-y-10"
           style="transition-delay: 0.2s">
          Our Work
        </a>

        <a href="/calculator" 
           class="menu-link font-display uppercase text-3xl md:text-5xl font-bold hover:text-brand-gold transition-all duration-300 opacity-0 translate-y-10"
           style="transition-delay: 0.25s">
          Calculator
        </a>
        

      </nav>

      <div class="relative z-50 mt-16 flex gap-8 items-center menu-link opacity-0 translate-y-10" style="transition-delay: 0.4s">
        <a href="https://web.facebook.com/helmcreativeet" target="_blank" class="text-brand-white hover:text-brand-gold text-2xl transition-colors">
            <i class="fa-brands fa-facebook-f"></i>
        </a>
        <a href="https://www.instagram.com/helm_creative_et" target="_blank" class="text-brand-white hover:text-brand-gold text-2xl transition-colors">
            <i class="fa-brands fa-instagram"></i>
        </a>
        <a href="https://www.tiktok.com/@helm.creatives" target="_blank" class="text-brand-white hover:text-brand-gold text-2xl transition-colors">
            <i class="fa-brands fa-tiktok"></i>
        </a>
        <a href="https://www.linkedin.com/company/helm-creatives/" target="_blank" class="text-brand-white hover:text-brand-gold text-2xl transition-colors">
            <i class="fa-brands fa-linkedin-in"></i>
        </a>
      </div>

    </div>

    <main class="relative z-10">
      <slot />
    </main>

    <footer class="relative min-h-[65vh] w-full flex flex-col justify-between overflow-hidden bg-[#FAF9F6] text-[#1a1a1a] pt-20 pb-10 px-5 md:px-8 lg:px-10">
      <div class="absolute inset-0 opacity-80" style="background:linear-gradient(135deg, rgba(26,26,26,0.025) 0%, rgba(26,26,26,0.01) 100%);"></div>

      <div class="relative z-10 w-full flex flex-col md:flex-row justify-between items-start gap-10 md:gap-12">
        <div class="max-w-xl">
          <h3 class="font-display font-bold text-5xl md:text-7xl leading-[0.9] tracking-[-0.06em] mb-8 text-[#1a1a1a]">
            Let’s Talk
          </h3>

          <div class="space-y-3 font-sans text-xl md:text-2xl leading-tight">
            <a href="mailto:calebwesley98@gmail.com" class="block text-[#1a1a1a] hover:text-[#1a1a1a]/70 transition-colors">calebwesley98@gmail.com</a>
            <a href="tel:+251959516667" class="block text-[#1a1a1a] hover:text-[#1a1a1a]/70 transition-colors">+251 959 516 667</a>
          </div>
        </div>

        <div class="w-full max-w-xl flex flex-col gap-4 md:items-end">
          <div class="flex items-center gap-4 md:gap-5 text-[#1a1a1a] text-xl md:text-2xl">
            <a href="https://www.facebook.com/helmcreativeet" target="_blank" rel="noreferrer" aria-label="Facebook" class="hover:opacity-70 transition-opacity"><i class="fa-brands fa-facebook-f"></i></a>
            <a href="https://www.instagram.com/helm_creative_et" target="_blank" rel="noreferrer" aria-label="Instagram" class="hover:opacity-70 transition-opacity"><i class="fa-brands fa-instagram"></i></a>
            <a href="https://www.tiktok.com/@helm.creatives" target="_blank" rel="noreferrer" aria-label="TikTok" class="hover:opacity-70 transition-opacity"><i class="fa-brands fa-tiktok"></i></a>
            <a href="https://www.linkedin.com/company/helm-creatives/" target="_blank" rel="noreferrer" aria-label="LinkedIn" class="hover:opacity-70 transition-opacity"><i class="fa-brands fa-linkedin-in"></i></a>
          </div>

          <div class="space-y-2 md:text-right">
            <p class="font-display font-bold text-2xl md:text-3xl leading-tight text-[#1a1a1a]">Addis Ababa, Ethiopia</p>
            <p class="font-display font-bold text-2xl md:text-3xl leading-tight text-[#1a1a1a]">Dubai, UAE</p>
          </div>
        </div>
      </div>

      <div class="relative z-10 flex justify-start md:justify-end mt-14 md:mt-20">
        <img src="/logo-icon/main-black.png" alt="Helm Logo" class="h-12 md:h-16 w-auto object-contain" />
      </div>
    </footer>

    <script>
      const initLayout = () => {
        const header = document.getElementById('site-header') as HTMLElement | null;
        const menuToggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
        const menuOverlay = document.getElementById('menu-overlay') as HTMLElement | null;
        const line1 = document.getElementById('line-1') as HTMLElement | null;
        const line2 = document.getElementById('line-2') as HTMLElement | null;
        const links = document.querySelectorAll('.menu-link, .menu-link a'); 
        let isOpen = false;

        if (!header || !menuToggle || !menuOverlay || !line1 || !line2) return;

        document.body.style.overflow = '';

        const toggleMenu = () => {
            isOpen = !isOpen;
            menuOverlay.classList.toggle('translate-x-full', !isOpen);
            menuOverlay.classList.toggle('opacity-0', !isOpen);
            
            if (isOpen) {
                menuOverlay.classList.remove('pointer-events-none');
                menuOverlay.classList.add('pointer-events-auto');
                document.body.style.overflow = 'hidden';
            } else {
                menuOverlay.classList.add('pointer-events-none');
                menuOverlay.classList.remove('pointer-events-auto');
                document.body.style.overflow = '';
            }
            
            line1.style.transform = isOpen ? 'translateY(4px) rotate(45deg)' : 'none';
            line2.style.transform = isOpen ? 'translateY(-3px) rotate(-45deg)' : 'none';
            line2.style.width = isOpen ? '32px' : '20px';

            const navLinks = document.querySelectorAll('.menu-link');
            navLinks.forEach(link => {
                link.classList.toggle('opacity-0', !isOpen);
                link.classList.toggle('translate-y-10', !isOpen);
            });
        };

        menuToggle.onclick = toggleMenu;

        links.forEach(link => {
            link.addEventListener('click', () => {
                if(isOpen) toggleMenu();
            });
        });

        /* --- Header Scroll Logic --- */
        const handleScroll = () => {
          if (window.scrollY > 50) {
            header.classList.add('bg-brand-navy/80', 'backdrop-blur-xl', 'py-5', 'border-b', 'border-brand-white/5');
          } else {
            header.classList.remove('bg-brand-navy/80', 'backdrop-blur-xl', 'py-5', 'border-b', 'border-brand-white/5');
          }
        };
        window.addEventListener('scroll', handleScroll);
        handleScroll();
      };

      initLayout();
    </script>

    <style is:global>
      /* Global Image & Text Loading Reveal */
      img, h1, h2, h3, p {
        animation: reveal 1s cubic-bezier(0.7, 0, 0.3, 1) forwards;
      }

      @keyframes reveal {
        from { opacity: 0; filter: blur(10px); transform: translateY(20px); }
        to { opacity: 1; filter: blur(0); transform: translateY(0); }
      }

      .cubic-bezier { transition-timing-function: cubic-bezier(0.7, 0, 0.3, 1); }
      
      ::-webkit-scrollbar { width: 0px; background: transparent; }
    </style>
  </body>
</html>