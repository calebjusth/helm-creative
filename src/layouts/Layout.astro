---
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "Helm Creative Agency - Leading Digital Studio for Design & Strategy", 
  image = "/logos/white_logo.png" 
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/fav.png" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title} | HELM™</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <ViewTransitions />
  </head>
  <body class="bg-[#0B0E14] text-[#f5f5f5] antialiased selection:bg-[#f5bd02] selection:text-black overflow-x-hidden cursor-none">
    
    <!-- Custom Cursor -->
    <div id="custom-cursor" class="fixed pointer-events-none z-[9999] mix-blend-difference">
      <div id="cursor-outer" class="absolute w-8 h-8 rounded-full border-2 border-white/30 transform -translate-x-1/2 -translate-y-1/2 transition-all duration-200 ease-out"></div>
      <div id="cursor-inner" class="absolute w-3 h-3 rounded-full bg-[#f5bd02] transform -translate-x-1/2 -translate-y-1/2 transition-all duration-100 ease-out"></div>
    </div>
    
    <div id="loader" class="fixed inset-0 z-[100] bg-[#0B0E14] flex flex-col items-center justify-center transition-opacity duration-500 pointer-events-none opacity-0">
      <div class="w-24 h-[1px] bg-white/20 relative overflow-hidden">
        <div id="loader-bar" class="absolute inset-0 bg-[#f5bd02] -translate-x-full"></div>
      </div>
    </div>

    <!-- Page transition curtain (two panels) -->
    <div id="curtain" class="fixed inset-0 z-[105] pointer-events-none">
      <div id="curtain-left" class="absolute top-0 left-0 h-full w-1/2 bg-[#0B0E14] transform -translate-x-full"></div>
      <div id="curtain-right" class="absolute top-0 right-0 h-full w-1/2 bg-[#0B0E14] transform translate-x-full"></div>
    </div>
    <header id="site-header" class="fixed top-0 left-0 w-full z-[70] p-6 md:px-12 md:py-8 flex justify-between items-center transition-all duration-500 ease-in-out">
      <a href="/" class="group flex items-center z-[80] custom-cursor-link">
        <img 
          src="/logos/white_logo.png" 
          alt="Helm Logo" 
          class="h-6 md:h-8 w-auto object-contain transition-transform duration-500 group-hover:scale-110" 
        />
      </a>

      <button id="menu-toggle" class="group flex items-center gap-4 custom-cursor-link z-[80] outline-none border-none bg-transparent">
        <span class="text-[10px] font-pangram-bold tracking-[0.3em] uppercase hidden md:block group-hover:text-[#f5bd02] transition-colors">
          Menu
        </span>
        <div class="flex flex-col gap-1.5 items-end">
          <span id="line-1" class="block w-8 h-[1px] bg-white group-hover:bg-[#f5bd02] transition-all duration-300"></span>
          <span id="line-2" class="block w-5 h-[1px] bg-white group-hover:bg-[#f5bd02] transition-all duration-300"></span>
        </div>
      </button>
    </header>

    <div id="menu-overlay" class="fixed inset-0 bg-[#0B0E14] z-[60] transform translate-x-full transition-transform duration-700 cubic-bezier flex items-center justify-center pointer-events-none opacity-0">
      <div class="absolute inset-0 bg-gradient-to-br from-[#f5bd02]/10 to-transparent opacity-30"></div>
      <nav class="relative z-10 flex flex-col items-center space-y-6 text-center">
        {['Home', 'Work', 'About', 'Contact'].map((item, i) => (
          <a href={item === 'Home' ? '/' : `/${item.toLowerCase()}`} 
             class="menu-link font-monument text-5xl md:text-8xl uppercase hover:text-[#f5bd02] transition-all duration-500 opacity-0 translate-y-10 custom-cursor-link"
             style={`transition-delay: ${i * 0.1}s`}>
            {item}
          </a>
        ))}
      </nav>
    </div>

    <main class="relative z-10" transition:animate="fade">
      <slot />
    </main>

    <footer class="relative min-h-[80vh] w-full flex flex-col justify-between overflow-hidden bg-[#0B0E14] text-[#f5f5f5] pt-40 pb-10 px-6 md:px-16">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[60vw] h-[60vw] bg-[#f5bd02] opacity-[0.05] blur-[120px] rounded-full pointer-events-none"></div>

      <div class="w-full flex flex-col md:flex-row justify-between items-end z-10 gap-12">
        <div class="max-w-2xl">
          <h3 class="font-monument text-4xl md:text-6xl uppercase leading-tight mb-8">
            Need a <span class="text-[#f5bd02] italic">design?</span>
          </h3>
          <a href="tel:+251977240817" class="inline-block border border-[#f5bd02] text-[#f5bd02] hover:bg-[#f5bd02] hover:text-black transition-all duration-500 px-10 py-5 rounded-full font-pangram-bold text-sm uppercase tracking-widest custom-cursor-link">
            Call Now
          </a>
        </div>
        
        <div class="flex flex-col gap-4 text-right font-pangram text-sm uppercase tracking-widest opacity-60">
          <a href="https://www.tiktok.com/@helm.creatives" target="_blank" class="hover:text-[#f5bd02] transition-colors custom-cursor-link">Tiktok</a>
          <a href="https://www.linkedin.com/company/helm-creatives/" target="_blank" class="hover:text-[#f5bd02] transition-colors custom-cursor-link">LinkedIn</a>
          <a href="https://web.facebook.com/Fkernew1064/?_rdc=1&_rdr" target="_blank" class="hover:text-[#f5bd02] transition-colors custom-cursor-link">Facebook</a>
        </div>
      </div>

      <div class="relative w-full z-10 mt-24 border-t border-white/10 pt-8 flex flex-col items-center">
        <div class="flex justify-between w-full text-[10px] uppercase tracking-[0.4em] opacity-30 mb-12 font-pangram">
          <span>© 2026 HELM™</span>
          <span>Studio — Digital</span>
        </div>
        <img 
          src="/logos/white_logo.png" 
          alt="Helm Large" 
          class="w-full h-auto object-contain opacity-[0.03] select-none pointer-events-none" 
        />
      </div>
    </footer>

    <script>
      const initLayout = () => {
        const header = document.getElementById('site-header');
        const menuToggle = document.getElementById('menu-toggle');
        const menuOverlay = document.getElementById('menu-overlay');
        const loader = document.getElementById('loader');
        const loaderBar = document.getElementById('loader-bar');
        const lines = [document.getElementById('line-1'), document.getElementById('line-2')];
        const links = document.querySelectorAll('.menu-link');
        let isOpen = false;

        // Reset Menu on page change
        document.body.style.overflow = '';

        // Custom Cursor Logic
        const cursorOuter = document.getElementById('cursor-outer');
        const cursorInner = document.getElementById('cursor-inner');
        const customCursor = document.getElementById('custom-cursor');
        
        // Hide cursor on touch devices
        if ('ontouchstart' in window || navigator.maxTouchPoints) {
          customCursor.style.display = 'none';
          document.body.classList.remove('cursor-none');
        } else {
          let mouseX = 0;
          let mouseY = 0;
          let cursorX = 0;
          let cursorY = 0;
          
          // Mouse move event
          document.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
            customCursor.style.opacity = '1';
          });
          
          // Mouse leave event
          document.addEventListener('mouseleave', () => {
            customCursor.style.opacity = '0';
          });
          
          // Mouse enter event
          document.addEventListener('mouseenter', () => {
            customCursor.style.opacity = '1';
          });
          
          // Animation loop for smooth cursor movement
          const animateCursor = () => {
            cursorX += (mouseX - cursorX) * 0.15;
            cursorY += (mouseY - cursorY) * 0.15;
            
            cursorOuter.style.left = cursorX + 'px';
            cursorOuter.style.top = cursorY + 'px';
            cursorInner.style.left = cursorX + 'px';
            cursorInner.style.top = cursorY + 'px';
            
            requestAnimationFrame(animateCursor);
          };
          
          animateCursor();
          
          // Handle link hover effects
          const cursorLinks = document.querySelectorAll('.custom-cursor-link, a, button, [role="button"]');
          
          cursorLinks.forEach(link => {
            link.addEventListener('mouseenter', () => {
              cursorOuter.style.width = '48px';
              cursorOuter.style.height = '48px';
              cursorOuter.style.borderColor = '#f5bd02';
              cursorOuter.style.backgroundColor = 'rgba(245, 189, 2, 0.1)';
              cursorInner.style.transform = 'translate(-50%, -50%) scale(1.5)';
            });
            
            link.addEventListener('mouseleave', () => {
              cursorOuter.style.width = '32px';
              cursorOuter.style.height = '32px';
              cursorOuter.style.borderColor = 'rgba(255, 255, 255, 0.3)';
              cursorOuter.style.backgroundColor = 'transparent';
              cursorInner.style.transform = 'translate(-50%, -50%) scale(1)';
            });
          });
        }

        // Loader & Curtain Logic for Page Transitions
        const curtain = document.getElementById('curtain');
        const curtainLeft = document.getElementById('curtain-left');
        const curtainRight = document.getElementById('curtain-right');

        const showCurtain = () => {
          curtain.classList.add('active');
          curtainLeft.style.transition = 'transform 420ms cubic-bezier(0.7,0,0.3,1)';
          curtainRight.style.transition = 'transform 420ms cubic-bezier(0.7,0,0.3,1)';
          curtainLeft.style.transform = 'translateX(0)';
          curtainRight.style.transform = 'translateX(0)';
          customCursor.style.opacity = '0';
        };

        const hideCurtain = () => {
          curtainLeft.style.transition = 'transform 520ms cubic-bezier(0.2,0,0,1) 120ms';
          curtainRight.style.transition = 'transform 520ms cubic-bezier(0.2,0,0,1) 120ms';
          curtainLeft.style.transform = 'translateX(-100%)';
          curtainRight.style.transform = 'translateX(100%)';
          setTimeout(() => {
            curtain.classList.remove('active');
            customCursor.style.opacity = '1';
          }, 800);
        };

        document.addEventListener('astro:before-preparation', () => {
          loader.classList.remove('opacity-0');
          loaderBar.style.transition = 'transform 1.5s cubic-bezier(0.7, 0, 0.3, 1)';
          loaderBar.style.transform = 'translateX(0)';
          showCurtain();
        });

        document.addEventListener('astro:after-preparation', () => {
          loader.classList.add('opacity-0');
          setTimeout(() => {
            loaderBar.style.transition = 'none';
            loaderBar.style.transform = 'translateX(-100%)';
          }, 500);
          setTimeout(hideCurtain, 80);
        });

        // Header Scroll Logic
        const handleScroll = () => {
          if (window.scrollY > 50) {
            header.classList.add('bg-[#0B0E14]/80', 'backdrop-blur-xl', 'py-5', 'border-b', 'border-white/5');
          } else {
            header.classList.remove('bg-[#0B0E14]/80', 'backdrop-blur-xl', 'py-5', 'border-b', 'border-white/5');
          }
        };
        window.addEventListener('scroll', handleScroll);
        handleScroll();

        // Menu Logic
        menuToggle.onclick = () => {
          isOpen = !isOpen;
          menuOverlay.classList.toggle('translate-x-full', !isOpen);
          menuOverlay.classList.toggle('opacity-0', !isOpen);
          menuOverlay.classList.toggle('pointer-events-auto', isOpen);
          document.body.style.overflow = isOpen ? 'hidden' : '';
          
          lines[0].style.transform = isOpen ? 'translateY(4px) rotate(45deg)' : 'none';
          lines[1].style.transform = isOpen ? 'translateY(-3px) rotate(-45deg)' : 'none';
          lines[1].style.width = isOpen ? '32px' : '20px';

          links.forEach(link => {
            link.classList.toggle('opacity-0', !isOpen);
            link.classList.toggle('translate-y-10', !isOpen);
          });
        };
      };

      initLayout();
      document.addEventListener('astro:after-swap', initLayout);
    </script>

    <style is:global>
      
      @import "tailwindcss";
      
      /* View Transitions Styling */
      ::view-transition-old(root) {
        animation: 0.4s cubic-bezier(0.7, 0, 0.3, 1) both slide-out;
      }
      ::view-transition-new(root) {
        animation: 0.6s cubic-bezier(0.7, 0, 0.3, 1) both slide-in;
      }

      @keyframes slide-out {
        from { transform: translateX(0); opacity: 1; }
        to { transform: translateX(-30px); opacity: 0; }
      }

      @keyframes slide-in {
        from { transform: translateX(30px); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
      }

      /* Global Image & Text Loading Reveal */
      img, h1, h2, h3, p {
        animation: reveal 1s cubic-bezier(0.7, 0, 0.3, 1) forwards;
      }

      @keyframes reveal {
        from { opacity: 0; filter: blur(10px); transform: translateY(20px); }
        to { opacity: 1; filter: blur(0); transform: translateY(0); }
      }

      /* Curtain panels for a cut & reveal page transition */
      #curtain { pointer-events: none; }
      #curtain-left, #curtain-right {
        will-change: transform, opacity;
      }
      #curtain.active { pointer-events: auto; }

      /* Custom Cursor Styling */
      #custom-cursor {
        opacity: 0;
        transition: opacity 0.3s ease;
      }
      
      #cursor-outer {
        will-change: transform;
        pointer-events: none;
      }
      
      #cursor-inner {
        will-change: transform;
        pointer-events: none;
      }

      /* Remove default cursor for non-touch devices */
      @media (hover: hover) and (pointer: fine) {
        * {
          cursor: none !important;
        }
        
        /* Optional: Keep text cursor for better UX */
        input, textarea, [contenteditable] {
          cursor: text !important;
        }
      }

      .cubic-bezier { transition-timing-function: cubic-bezier(0.7, 0, 0.3, 1); }

      /* Font Helpers */
      .font-monument { font-family: 'Monument Extended', sans-serif; }
      .font-pangram { font-family: 'Pangram Sans', sans-serif; }
      .font-pangram-bold { font-family: 'Pangram Sans', sans-serif; font-weight: 700; }

      ::-webkit-scrollbar { width: 0px; background: transparent; }
    </style>
  </body>
</html>