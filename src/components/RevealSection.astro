<section id="reveal-container" class="relative h-screen w-full overflow-hidden bg-[#0B0E14] z-30 flex items-center justify-center">
  <div id="reveal-box" class="relative w-[80%] h-[80%] bg-[#b88e02] rounded-3xl flex flex-col items-center justify-center overflow-hidden shadow-[0_0_50px_rgba(0,0,0,0.5)]">
    
    <div id="reveal-content" class="opacity-0 flex flex-col items-center text-center px-6 w-full h-full relative">
      
      <div class="flex items-center gap-2 mb-8 reveal-item">
        <span class="bg-black text-[#b88e02] font-pangram-bold text-xs px-2 py-1 rounded">1</span>
        <span class="text-black font-pangram-bold text-xs  tracking-widest border border-black/20 px-3 py-1 rounded-full">We are</span>
      </div>

      <h2 class="font-pangram-bold text-5xl md:text-8xl lg:text-[9rem] text-[#0B0E14] leading-[0.85] tracking-tighter mb-4 reveal-item">
        Architects <br/> of Vision
      </h2>

      <div id="reveal-image" class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-6 md:translate-y-12 w-[90%] md:w-[60%] lg:w-[45%] z-20">
        <img 
          src="/helm_navigator-copy.png" 
          alt="Architectural Asset" 
          class="w-full h-auto object-contain drop-shadow-[0_-20px_50px_rgba(0,0,0,0.3)]" 
        />
      </div>
    </div>
  </div>
</section>
