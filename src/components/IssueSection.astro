---
---

<section id="parallax-section" class="relative min-h-screen w-full overflow-hidden bg-[#0B0E14] py-20">
    
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden">
      <h2 id="parallax-bg-text" class="font-monument text-[15vw] md:text-[20vw]  opacity-[0.03] leading-none whitespace-nowrap transition-transform duration-100 ease-out">
        STRATEGY
      </h2>
    </div>

    <div id="issue-section" class="relative z-20 w-full h-full flex flex-col items-center justify-center px-6 md:px-16 lg:px-24">
      
      <div class="text-center mb-12 md:mb-20 scroll-reveal">
        <h3 class="font-monument text-3xl md:text-5xl  leading-tight">
          The <span class="text-[#f5bd02]">Navigator</span> <br /> Blueprint
        </h3>
      </div>

      <div class="max-w-7xl w-full grid grid-cols-1 lg:grid-cols-3 items-center gap-12 lg:gap-4">
        
        <div class="caption-left col-span-1 flex justify-center lg:justify-end order-2 lg:order-1">
          <div class="caption-bubble reveal-left font-monument text-xl md:text-2xl text-white bg-white/5 backdrop-blur-md border border-white/10 rounded-3xl p-8 md:p-10 max-w-md shadow-2xl">
            <span class="text-[#f5bd02] block mb-4 text-xs font-pangram-bold tracking-[0.4em] ">Insight</span>
            We are strategists — building direction, not just design. We map the path from insight to impact.
          </div>
        </div>

        <div class="col-span-1 flex items-center justify-center order-1 lg:order-2">
          <div class="issue-image-wrap relative w-[280px] md:w-[400px] lg:w-[500px]">
            <div class="absolute inset-0 bg-[#f5bd02]/20 blur-[100px] rounded-full"></div>
            <img 
              src="/caleb_bg.png" 
              alt="Issue visual" 
              class="issue-image relative z-10 w-full h-auto object-contain drop-shadow-[0_20px_50px_rgba(0,0,0,0.5)] transition-all duration-1000 scale-90 opacity-0" 
            />
          </div>
        </div>

        <div class="caption-right col-span-1 flex justify-center lg:justify-start order-3">
          <div class="reveal-right font-monument text-xl md:text-2xl text-white bg-white/5 backdrop-blur-md border border-white/10 rounded-3xl p-8 md:p-10 max-w-md shadow-2xl">
            <span class="text-[#f5bd02] block mb-4 text-xs font-pangram-bold tracking-[0.4em] ">Impact</span>
            Strategy begins with understanding. We turn ambiguity into decisive plans aligned to your goals.
          </div>
        </div>
      </div>
    </div>
  </section>

<style>
  /* Entrance Animations */
  .reveal-left, .reveal-right, .scroll-reveal {
    opacity: 0;
    transition: all 1.2s cubic-bezier(0.7, 0, 0.3, 1);
  }

  .reveal-left { transform: translateX(-50px); }
  .reveal-right { transform: translateX(50px); }
  .scroll-reveal { transform: translateY(30px); }

  .reveal-left.active, .reveal-right.active, .scroll-reveal.active {
    opacity: 1;
    transform: translate(0);
  }

  /* High-end glass effect for bubbles */
  .caption-bubble {
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }
</style>

<script>
  const observeParallax = () => {
    const section = document.getElementById('parallax-section');
    const bgText = document.getElementById('parallax-bg-text');
    const image = document.querySelector('.issue-image');
    const reveals = document.querySelectorAll('.reveal-left, .reveal-right, .scroll-reveal');

    // Intersection Observer for the entrance animation
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          image.classList.remove('opacity-0', 'scale-90');
          image.classList.add('opacity-100', 'scale-100');
          
          reveals.forEach((el, i) => {
            setTimeout(() => {
              el.classList.add('active');
            }, i * 200);
          });
        }
      });
    }, { threshold: 0.3 });

    if (section) observer.observe(section);

    // Parallax Scroll Effect
    window.addEventListener('scroll', () => {
      const scrolled = window.pageYOffset;
      const sectionTop = section.offsetTop;
      if (scrolled > sectionTop - window.innerHeight && scrolled < sectionTop + section.offsetHeight) {
        const move = (scrolled - sectionTop) * 0.15;
        bgText.style.transform = `translateX(${move}px)`;
      }
    });
  };

  observeParallax();
  document.addEventListener('astro:after-swap', observeParallax);
</script>
