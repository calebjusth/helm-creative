---
const services = [
  {
    title: 'Branding',
    description: 'A brand is more than a logo. It is how people recognize, remember, and connect with your business. We create strong visual systems and strategic direction that help you stand out and stay memorable in a crowded market.'
  },
  {
    title: 'Marketing',
    description: 'Marketing is how you turn attention into momentum. We build campaigns that reach the right audience, create demand, and keep your business visible in the moments that matter.'
  },
  {
    title: 'Web Development',
    description: 'Your website should do more than look good. It should work hard, convert visitors, and represent your business with clarity and confidence.'
  },
  {
    title: 'UI/UX',
    description: 'The best experiences feel effortless. We design interfaces that are clean, intuitive, and built around how people actually think, click, and decide.'
  },
  {
    title: 'Events',
    description: 'Events are where stories, people, and brands collide. We create event experiences that feel organized, elevated, and unforgettable from start to finish.'
  }
];
---

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />

<section id="services" class="relative w-full bg-[#FAF9F6] text-[#1a1a1a]">
  <div class="w-full">
    <div class="w-full overflow-hidden">
      <img
        src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1800&q=80"
        alt="Creative agency work"
        class="block w-full h-[380px] md:h-[620px] object-cover"
      />
    </div>

    <div class="max-w-7xl mx-auto py-16 md:py-24">
      <div class="grid gap-8 md:gap-12 lg:grid-cols-[0.7fr_1.3fr] items-start px-6 md:px-10">
        <div class="lg:pt-4">
          <p class="text-[11px] md:text-xs font-sans uppercase tracking-[0.28em] text-[#1a1a1a]/70 mb-3">What We Do</p>
          <h3 class="font-display text-3xl md:text-5xl leading-tight tracking-[-0.04em] text-[#1a1a1a] max-w-md">
            We build brands for growing businesses.
          </h3>
        </div>

        <div class="space-y-0">
          {services.map((service) => (
            <details class="group border-b border-[#1a1a1a]/15 open:border-[#1a1a1a]/20 transition-all duration-300">
              <summary class="cursor-pointer list-none flex items-center justify-between gap-4 py-5 md:py-7 text-left">
                <span class="font-display font-bold text-2xl md:text-[2.4rem] leading-none tracking-[-0.05em] text-[#1a1a1a]">{service.title}</span>
                <i class="fa-solid fa-chevron-down text-base md:text-lg text-[#1a1a1a]/55 transition-transform duration-300 group-open:rotate-180"></i>
              </summary>
              <div class="pb-6 md:pb-8">
                <p class="font-sans text-base md:text-lg leading-relaxed text-[#1a1a1a] max-w-3xl">{service.description}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
