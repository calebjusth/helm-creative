---
export interface Props {
  allCols: Array<{ images: string[]; speed: number; offset: string }>;
}
const { allCols } = Astro.props;
---

<section class="relative min-h-[70vh] w-full flex items-center px-5 md:px-8 lg:px-10 pt-32 md:pt-40 pb-16">
  <div class="z-20 w-full max-w-7xl mx-auto">
    <h1 class="font-display font-bold text-4xl sm:text-5xl md:text-6xl lg:text-[5rem] leading-[0.96] tracking-[-0.04em] text-brand-white max-w-4xl">
      Everything Creative in One Room
    </h1>
  </div>
</section>
