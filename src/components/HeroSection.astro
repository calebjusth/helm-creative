---
export interface Props {
  allCols: Array<{ images: string[]; speed: number; offset: string }>;
}
const { allCols } = Astro.props;
---

<section class="relative min-h-screen w-full flex flex-col md:flex-row bg-[#0B0E14] overflow-hidden items-center px-6 md:px-16 lg:px-24">
  <div class="z-20 w-full md:w-1/2 space-y-8 pt-40 md:pt-48 pb-20 flex flex-col justify-center">
    <h1 class="font-monument text-3xl sm:text-4xl md:text-4xl lg:text-[2.8rem] leading-[1.1] text-white">
      <span class="hero-word">Dream.</span>
      <span class="hero-word italic text-[#f5bd02] font-normal">Create.</span>
      <br class="md:hidden"/>
      <span class="hero-word tracking-tighter">Lead.</span>
    </h1>
    <p class="font-pangram text-white/80 text-sm md:text-base max-w-md leading-relaxed">
      We are Helm. A creative agency crafting futuristic communication, branding, and digital products. Moving Ethiopian design forward, one dream at a time.
    </p>
    <div>
      <a href="https://t.me/alpha_valley" target="_blank" class="group relative inline-block bg-[#f5bd02] text-black px-8 md:px-10 py-4 md:py-5 rounded-full font-pangram-bold text-[12px] md:text-sm  tracking-widest overflow-hidden transition-all hover:pr-14">
        <span class="relative z-10">Let&apos;s Talk</span>
        <span class="absolute right-6 top-1/2 -translate-y-1/2 group-hover:opacity-100 transition-all duration-300">→</span>
      </a>
    </div>
  </div>

  <div class="absolute right-0 top-0 w-full md:w-[45%] h-full flex gap-3 md:gap-6 px-4 py-0 opacity-20 md:opacity-100 pointer-events-none">
    {allCols.map((col) => (
      <div class={`marquee-col flex-1 flex flex-col gap-4 lg:gap-6 ${col.offset}`} data-speed={col.speed}>
        <div class="marquee-inner flex flex-col gap-4 lg:gap-6">
          {col.images.concat(col.images).map((img) => (
            <div class="w-full rounded-xl md:rounded-2xl overflow-hidden bg-white/5 aspect-[4/5] shadow-2xl image-protection">
              <img src={img} class="w-full h-full object-cover grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all duration-700" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    ))}
    <div class="absolute inset-0 bg-gradient-to-b md:bg-gradient-to-r from-[#0B0E14] via-[#0B0E14]/60 md:via-transparent to-transparent z-10"></div>
  </div>
</section>
