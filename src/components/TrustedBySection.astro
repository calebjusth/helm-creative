---
export interface Props {
  logosRow1: Array<{ name: string; src: string }>;
  logosRow2: Array<{ name: string; src: string }>;
}
const { logosRow1, logosRow2 } = Astro.props;
---

<section class="py-16 md:py-32 overflow-hidden z-10 relative bg-[#1a1a1a] text-[#FAF9F6]">
  <div class="w-full mb-12 md:mb-24 space-y-4 md:space-y-8">
    <div class="text-center mb-8 md:mb-12 px-6">
      <p class="font-display font-bold text-2xl md:text-4xl tracking-[0.1em] text-[#FAF9F6]">
        Trusted by
      </p>
    </div>

    <div class="relative w-full overflow-hidden logo-marquee-wrapper mt-10 md:mt-20 flex items-center" data-direction="left">
      <div class="logo-track flex gap-6 md:gap-16 lg:gap-24 w-max items-center opacity-100 grayscale cursor-grab active:cursor-grabbing">
          {logosRow1.map((logo) => (
            <img 
              src={logo.src} 
              alt={logo.name} 
              class="h-5 md:h-8 lg:h-10 w-auto object-contain shrink-0 brightness-0 invert" 
            />
          ))}
      </div>
    </div>
    
    <div class="relative w-full overflow-hidden logo-marquee-wrapper mt-4 md:mt-6 flex items-center" data-direction="right">
      <div class="logo-track flex gap-6 md:gap-16 lg:gap-24 w-max items-center opacity-100 grayscale cursor-grab active:cursor-grabbing">
          {logosRow2.map((logo) => (
            <img 
              src={logo.src} 
              alt={logo.name} 
              class="h-5 md:h-8 lg:h-10 w-auto object-contain shrink-0 brightness-0 invert" 
            />
          ))}
      </div>
    </div>
  </div>
</section>