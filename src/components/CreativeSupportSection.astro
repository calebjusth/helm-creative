---
---

<section id="creative-support" class="relative w-full bg-[#FAF9F6] text-[#1a1a1a] px-5 md:px-8 lg:px-10 py-20 md:py-28">
  <div class="relative max-w-7xl mx-auto overflow-hidden flex flex-col items-center pt-4 md:pt-8">
    
    <div class="relative z-10 max-w-4xl text-center space-y-8 px-6 mb-16 md:mb-20">
      <h2 class="font-display font-bold text-5xl md:text-7xl text-[#1a1a1a] tracking-[-0.06em] leading-[0.9] cs-animate">
        Bring your next idea to life.
      </h2>
      
      <p class="font-sans text-xl md:text-2xl text-[#1a1a1a]/75 max-w-2xl mx-auto cs-animate delay-100">
        From the first idea to the final launch, Helm helps you turn ambitious creative work into something real.
      </p>
    </div>

    <div class="relative z-10 w-full cs-animate delay-300">
      <img 
        src="/mockup.jpg" 
        alt="Creative Support Mockup" 
        class="w-full h-auto object-cover translate-y-4 hover:translate-y-0 transition-transform duration-700 ease-out" 
      />
    </div>

  </div>
</section>

<style>
  /* Cinematic Blur-in Animation 
    Starts blurry, invisible, and slightly pushed down, then locks into place.
  */
  #creative-support .cs-animate {
    opacity: 0;
    transform: translateY(30px);
    filter: blur(16px);
    transition: opacity 1000ms cubic-bezier(0.2, 0.9, 0.2, 1), 
                transform 1000ms cubic-bezier(0.2, 0.9, 0.2, 1),
                filter 1000ms cubic-bezier(0.2, 0.9, 0.2, 1);
  }

  /* Triggers when JS adds the .in-view class */
  #creative-support.in-view .cs-animate {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  /* Stagger delays for that cascading 1-2-3 reveal */
  #creative-support .delay-100 { transition-delay: 100ms; }
  #creative-support .delay-200 { transition-delay: 200ms; }
  #creative-support .delay-300 { transition-delay: 300ms; }

  /* Accessibility: Disable heavy motion for users who prefer it */
  @media (prefers-reduced-motion: reduce) {
    #creative-support .cs-animate {
      transition: none;
      transform: none;
      filter: none;
      opacity: 1;
    }
  }
</style>

<script>
  // IntersectionObserver to trigger the blur/fade in when scrolled into view
  document.addEventListener("DOMContentLoaded", () => {
    const el = document.getElementById('creative-support');
    if (!el || typeof IntersectionObserver === 'undefined') return;
    
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          el.classList.add('in-view');
          obs.unobserve(el); // Only animate once
        }
      });
    }, { threshold: 0.20 }); // Triggers when 20% of the section is visible
    
    obs.observe(el);
    
    // Astro view transitions support
    document.addEventListener('astro:after-swap', () => { 
      const newEl = document.getElementById('creative-support');
      if (newEl) {
        newEl.classList.remove('in-view');
        obs.observe(newEl); 
      }
    });
  });
</script>