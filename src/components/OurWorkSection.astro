---
export interface Props {
  workProjects: Array<{
    image: string;
    service: string;
    year: string;
    url?: string;
    caseStudy: string;
  }>;
}

const { workProjects } = Astro.props;

// Compute grid classes dynamically:
// Row 0: Left larger (7 cols), Right smaller (5 cols)
// Row 1: Left smaller (5 cols), Right larger (7 cols)
// Alternates continuously across all rows.
function getColSpanClass(index: number) {
  const row = Math.floor(index / 2);
  const isEvenRow = row % 2 === 0;
  const isFirstInRow = index % 2 === 0;

  if (isEvenRow) {
    return isFirstInRow ? "md:col-span-7" : "md:col-span-5";
  } else {
    return isFirstInRow ? "md:col-span-5" : "md:col-span-7";
  }
}

const gridItems = workProjects.map((project, index) => ({
  project,
  colSpanClass: getColSpanClass(index),
}));
---

<section id="our-work" class="relative w-full bg-[#FAF9F6] py-12 md:py-20">
  <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10">
    <!-- Header: right-aligned, small and legible -->
    <div class="mb-10 flex justify-end">
      <p class="max-w-xs text-right font-sans text-[25px] md:text-[30px] leading-snug -tracking-tightest text-[#1a1a1a]">
        We transform ambitious brands so they
        dominate their market.
      </p>
    </div>

    <!-- Alternating 2-Column Grid Layout with spacing -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 border-t border-b border-[#1a1a1a]/10 py-8 md:py-12">
      {gridItems.map(({ project, colSpanClass }) => (
        <article class={`group flex flex-col ${colSpanClass}`}>
          {project.url === '/deja' ? (
            <a href={project.url} aria-label={`Read the ${project.caseStudy} case study`} class="flex flex-col focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#8F3B32]">
              <div class="overflow-hidden bg-[#D9D4CF] relative cursor-none">
                <img
                  src={project.image}
                  alt={`${project.caseStudy} brand identity and packaging`}
                  class="project-card-img h-87.5 md:h-125 lg:h-137.5 w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
                  loading="lazy"
                  data-preview={project.image}
                />
              </div>

              <div class="py-4 pr-4 flex flex-col justify-between">
                <div>
                  <p class="font-display font-bold text-base md:text-lg leading-tight tracking-[-0.02em] text-[#1a1a1a]">
                    {project.caseStudy}
                  </p>
                  <p class="mt-1 font-sans text-xs tracking-normal text-[#1a1a1a]/70">
                    {project.service}
                  </p>
                </div>
              </div>
            </a>
          ) : (
            <div class="flex flex-col">
              <div class="overflow-hidden bg-[#D9D4CF] relative cursor-none">
                <img
                  src={project.image}
                  alt={`${project.caseStudy} brand identity and packaging`}
                  class="project-card-img h-87.5 md:h-125 lg:h-137.5 w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
                  loading="lazy"
                  data-preview={project.image}
                />
              </div>

              <div class="py-4 pr-4 flex flex-col justify-between">
                <div>
                  <p class="font-display font-bold text-base md:text-lg leading-tight tracking-[-0.02em] text-[#1a1a1a]">
                    {project.caseStudy}
                  </p>
                  <p class="mt-1 font-sans text-xs tracking-normal text-[#1a1a1a]/70">
                    {project.service}
                  </p>
                </div>
              </div>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>

  <!-- Custom Floating Cursor element — kept as the LAST element in the
       section so it always paints on top of everything above it, and
       given an explicit inline z-index so no other z-index class or
       stacking context can bury it. -->
  <div
    id="custom-cursor"
    style="z-index: 9999; opacity: 0;"
    class="pointer-events-none fixed top-0 left-0 h-28 w-28 -translate-x-1/2 -translate-y-1/2 overflow-hidden border border-[#1a1a1a]/20 transition-opacity duration-300 ease-out shadow-2xl"
  >
    <img
      id="cursor-img"
      src=""
      alt="Hover preview"
      class="h-full w-full object-cover"
    />
  </div>
</section>

<script>
  // Floating cursor thumbnail — kept deliberately simple:
  // 1. Move the cursor element to <body> so no ancestor on the page
  //    (overflow-hidden, transform, etc.) can ever clip or reposition
  //    a `position: fixed` element — the #1 cause of "cursor hides but
  //    thumbnail never shows".
  // 2. Toggle visibility with plain inline styles, not Tailwind classes,
  //    so nothing depends on those utility classes existing in the
  //    compiled CSS.
  const cursor = document.getElementById('custom-cursor');
  const cursorImg = document.getElementById('cursor-img') as HTMLImageElement | null;

  if (cursor && cursorImg) {
    document.body.appendChild(cursor);

    let mouseX = 0;
    let mouseY = 0;
    let cursorX = 0;
    let cursorY = 0;

    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    // Smooth follow via requestAnimationFrame
    function animateCursor() {
      cursorX += (mouseX - cursorX) * 0.15;
      cursorY += (mouseY - cursorY) * 0.15;
      cursor.style.transform = `translate3d(${cursorX}px, ${cursorY}px, 0) translate(-50%, -50%)`;
      requestAnimationFrame(animateCursor);
    }
    requestAnimationFrame(animateCursor);

    // Bind directly to each project image
    document.querySelectorAll<HTMLImageElement>('.project-card-img').forEach((img) => {
      img.addEventListener('mouseenter', () => {
        const previewUrl = img.getAttribute('data-preview');
        if (previewUrl) cursorImg.src = previewUrl;
        cursor.style.opacity = '1';
      });

      img.addEventListener('mouseleave', () => {
        cursor.style.opacity = '0';
      });
    });
  }
</script>