---
export interface Props {
  workProjects: Array<{
    image: string;
    service: string;
    year: string;
    url: string;
    caseStudy: string;
  }>;
}
const { workProjects } = Astro.props;
---

<section id="our-work" class="relative w-full py-16 md:py-40 bg-[#f5f5f5] overflow-hidden text-[#0B0E14]">
  <div class="max-w-7xl mx-auto px-6 md:px-16 lg:px-24">
    
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 md:mb-16 gap-6 md:gap-8">
      <div class="max-w-xl">
        <span class="font-pangram-bold text-[#f5bd02] text-[10px] md:text-xs  tracking-[0.3em] mb-3 md:mb-4 block">
          Selected Projects
        </span>
        <h3 class="font-monument text-3xl md:text-6xl leading-tight md:leading-none">
          Crafting <br class="hidden md:block" /> <span class="italic text-transparent stroke-black">Digital</span> Legacies
        </h3>
      </div>
      <p class="font-pangram text-xs md:text-base max-w-xs opacity-70 leading-relaxed border-l border-black/10 pl-4 md:pl-6">
        We blend strategy with high-end aesthetics to build brands that lead. Explore our latest creative interventions.
      </p>
    </div>

    <div class="work-marquee-wrapper relative cursor-grab active:cursor-grabbing">
      <div class="work-track flex gap-4 md:gap-8 items-start w-max">
        {workProjects.concat(workProjects).map((project, i) => (
          <div class="work-item group relative flex-shrink-0 rounded-xl md:rounded-2xl overflow-hidden shadow-2xl shadow-black/5 bg-black/5">
            
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent md:bg-black/40 opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 z-10 flex flex-col justify-end p-5 md:p-8">
              <a href={project.url} class="text-white font-monument text-lg md:text-xl md:translate-y-4 md:group-hover:translate-y-0 transition-transform duration-500">
                {project.caseStudy}
              </a>
              <span class="text-[#f5bd02] font-pangram text-[10px] md:text-xs  tracking-widest mt-1 md:mt-2">
                {project.service} — {project.year}
              </span>
            </div>
            
            <img 
              src={project.image} 
              alt={`${project.service} Project`} 
              class="h-[45vh] md:h-[75vh] w-auto object-cover grayscale-[20%] md:group-hover:grayscale-0 md:group-hover:scale-105 transition-all duration-700 ease-out" 
              loading="lazy" 
            />
          </div>
        ))}
      </div>
    </div>
    
    <div class="mt-8 md:mt-12 flex justify-between items-center opacity-30 font-pangram text-[9px] md:text-[10px]  tracking-[0.2em]">
      <span>Drag to Explore</span>
      <div class="h-[1px] flex-grow mx-4 md:mx-8 bg-black/20"></div>
      <span>Scroll for More</span>
    </div>
  </div>
</section>

<style>
  /* Seamless Marquee Animation */
  .work-track {
    animation: scroll 40s linear infinite;
  }

  .work-track:hover {
    animation-play-state: paused;
  }

  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* Outline text helper */
  .stroke-black {
    -webkit-text-stroke: 1px #0B0E14;
  }
</style>
